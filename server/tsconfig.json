{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@modules/*": ["modules/*"],
      "@ws/*": ["ws/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*"]
}